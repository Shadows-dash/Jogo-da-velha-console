# Jogo da Velha - Console (Python)

# --------- Variáveis globais ---------
tabuleiro = [" " for _ in range(9)]
jogador_atual = "X"
placar = {"X": 0, "O": 0}

# --------- Funções ---------
def mostrar_tabuleiro():
    print("\n")
    print(f" {tabuleiro[0]} | {tabuleiro[1]} | {tabuleiro[2]} ")
    print("---+---+---")
    print(f" {tabuleiro[3]} | {tabuleiro[4]} | {tabuleiro[5]} ")
    print("---+---+---")
    print(f" {tabuleiro[6]} | {tabuleiro[7]} | {tabuleiro[8]} ")
    print("\n")

def verificar_vencedor():
    combinacoes = [
        (0,1,2), (3,4,5), (6,7,8),  # linhas
        (0,3,6), (1,4,7), (2,5,8),  # colunas
        (0,4,8), (2,4,6)            # diagonais
    ]
    for a,b,c in combinacoes:
        if tabuleiro[a] != " " and tabuleiro[a] == tabuleiro[b] == tabuleiro[c]:
            return tabuleiro[a]
    if " " not in tabuleiro:
        return "Empate"
    return None

def jogar():
    global jogador_atual, tabuleiro
    tabuleiro = [" " for _ in range(9)]
    vencedor = None

    while vencedor is None:
        mostrar_tabuleiro()
        try:
            pos = int(input(f"Jogador {jogador_atual}, escolha uma posição (1-9): ")) - 1
            if pos < 0 or pos > 8 or tabuleiro[pos] != " ":
                print("Posição inválida. Tente novamente.")
                continue
        except ValueError:
            print("Digite um número válido de 1 a 9.")
            continue

        tabuleiro[pos] = jogador_atual
        vencedor = verificar_vencedor()

        if vencedor is None:
            jogador_atual = "O" if jogador_atual == "X" else "X"

    mostrar_tabuleiro()
    if vencedor == "Empate":
        print("A partida terminou em empate!\n")
    else:
        print(f"Jogador {vencedor} venceu!\n")
        placar[vencedor] += 1

def mostrar_placar():
    print(f"Placar -> X: {placar['X']} | O: {placar['O']}\n")

# --------- Loop principal ---------
if __name__ == "__main__":
    while True:
        jogar()
        mostrar_placar()
        continuar = input("Deseja jogar novamente? (s/n): ").lower()
        if continuar != "s":
            print("Obrigado por jogar! Até mais 👋")
            break
